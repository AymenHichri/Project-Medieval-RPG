class_name BattleSetup
extends Resource
## Everything a battle needs to start: built by the map (random encounter) or a BossTrigger.

@export var enemies: Array[EnemyData] = []
@export var background: PackedScene
@export var music: MusicTrack
@export var can_flee: bool = true
@export var is_boss: bool = false
## Rare group: the presenter plays a special intro sting.
@export var is_rare: bool = false
## Intro line, e.g. "A pack of Wolves emerges!". Empty = generated by the presenter.
@export var intro_text: String = ""
## GameState flag set when this battle is won (a boss's `defeated_flag`; set by
## SceneManager.end_battle with the rewards). Empty = none.
@export var victory_flag: StringName = &""
