# Godot 4+ specific ignores
.godot/
/android/
/export/
*.tmp

# Original downloaded asset zips (2.6 GB) — never committed; checksums in tools/source_assets.sha256
assests/**/*.zip

# OS / editor noise
Thumbs.db
.DS_Store

# Processed audio copies: rebuilt from assests/audio_sources/ by tools/import_audio.py. The
# Dreamgarden and AlkaKrab licences forbid redistributing the files, and this repository is public.
# (Their .import files are kept so the resource UIDs stay stable.)
assets/audio/**/*.ogg
assets/audio/**/*.wav
